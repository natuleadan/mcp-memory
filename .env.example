OLLAMA_HOST=http://localhost:11434
CODING_DIR=/path/to/workspace1,/path/to/workspace2
CHATLOG_DIR=/path/to/your/_memory/chatlogs
LANCEDB_DIR=/path/to/your/_memory/vectorial
MEMORIES_DIR=/path/to/your/_memory/memories
MEMORIES_WRITE_ENABLED=true
# IGNORE_PREFIXES=_deprecated,_archive,.tmp  # files/dirs starting with these prefixes are skipped during indexing (default: _)
# BATCH_SIZE=500  # chunks per batch for embedding and parallel file reads (default: 20)
